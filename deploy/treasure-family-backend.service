[Unit]
Description=Treasure Family Backend
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=simple
WorkingDirectory=/opt/treasure-family-backend
EnvironmentFile=/etc/treasure-family/backend.env
ExecStart=/usr/bin/java -Xms128m -Xmx384m -jar /opt/treasure-family-backend/treasure-family-backend.jar --spring.profiles.active=prod
SuccessExitStatus=143
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
